# RAUC A/B boot logic for Raspberry Pi 4 (arm64). Partitions on mmc 0:
#   1 = FAT (firmware, u-boot, boot.scr, uboot.env)   2 = rootfs A   3 = rootfs B   4 = /data
# Kernel is loaded from /boot/Image inside the selected rootfs.

test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "A B"
test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3
test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3

setenv raucslot
setenv rootpart

for BOOT_SLOT in "${BOOT_ORDER}"; do
  if test -n "${raucslot}"; then
    # slot already chosen, skip the rest
  elif test "x${BOOT_SLOT}" = "xA"; then
    if test ${BOOT_A_LEFT} -gt 0; then
      setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1
      echo "Trying to boot slot A, ${BOOT_A_LEFT} attempts remaining"
      setenv raucslot A
      setenv rootpart 2
    fi
  elif test "x${BOOT_SLOT}" = "xB"; then
    if test ${BOOT_B_LEFT} -gt 0; then
      setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1
      echo "Trying to boot slot B, ${BOOT_B_LEFT} attempts remaining"
      setenv raucslot B
      setenv rootpart 3
    fi
  fi
done

if test -z "${raucslot}"; then
  echo "No valid slot found, resetting tries to 3"
  setenv BOOT_A_LEFT 3
  setenv BOOT_B_LEFT 3
  saveenv
  reset
fi

saveenv

setenv bootargs "console=tty1 console=serial0,115200 root=/dev/mmcblk0p${rootpart} rootwait rw rootfstype=ext4 rauc.slot=${raucslot}"

load mmc 0:${rootpart} ${kernel_addr_r} /boot/Image
booti ${kernel_addr_r} - ${fdt_addr}

echo "Boot of slot ${raucslot} failed, resetting"
reset
